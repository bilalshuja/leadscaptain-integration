APP_NAME=LeadscaptainIntegration
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=leadscaptain
DB_USERNAME=leadscaptain_user
DB_PASSWORD=secret_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Redis Configuration (Horizon & Cache)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Leadscaptain Client Configuration 
LEADSCAPTAIN_BASE_URL=https://api.leadscaptain.com
LEADSCAPTAIN_API_KEY=
LEADSCAPTAIN_TIMEOUT=15
LEADSCAPTAIN_RETRY_TIMES=3
LEADSCAPTAIN_CONCURRENCY=10
LEADSCAPTAIN_PER_PAGE=100
LEADSCAPTAIN_RATE_LIMIT=60