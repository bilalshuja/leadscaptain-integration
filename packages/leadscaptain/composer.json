{
    "name": "leadscaptain/laravel-integration",
    "description": "Enterprise Leadscaptain API Integration Package",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/bus": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/database": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Leadscaptain\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Leadscaptain\\Providers\\LeadscaptainServiceProvider"
            ]
        }
    }
}